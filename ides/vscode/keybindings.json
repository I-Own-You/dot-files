// Place your key bindings in this file to override the defaults
[
    // {
    // "key": "alt+t",
    // "command": "editor.action.addSelectionToNextFindMatch"
    // },
    {
        "key": "ctrl+alt+,",
        "command": "workbench.action.openSettingsJson"
    },
    {
        "key": "ctrl+alt+.",
        "command": "workbench.action.openGlobalKeybindingsFile"
    },
    {
        "key": "alt+p",
        "command": "workbench.action.showCommands"
    },
    {
        "key": "alt+p",
        "command": "workbench.action.closeQuickOpen",
        "when": "inQuickOpen"
    },
    {
        "key": "alt+f",
        "command": "workbench.action.quickOpen"
    },
    {
        "key": "alt+f",
        "command": "workbench.action.closeQuickOpen",
        "when": "inQuickOpen"
    },
    {
        "key": "alt+b",
        "command": "workbench.action.showAllEditors"
    },
    {
        "key": "alt+b",
        "command": "workbench.action.closeQuickOpen",
        "when": "inQuickOpen"
    },
    {
        "key": "ctrl+n",
        "command": "workbench.action.quickOpenSelectNext",
        "when": "inQuickOpen"
    },
    {
        "key": "ctrl+p",
        "command": "workbench.action.quickOpenSelectPrevious",
        "when": "inQuickOpen"
    },
    {
        "key": "ctrl+n",
        "command": "selectNextSuggestion",
        "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus || suggestWidgetVisible && textInputFocus && !suggestWidgetHasFocusedSuggestion && !supermaven-view.visible"
    },
    {
        "key": "ctrl+p",
        "command": "selectPrevSuggestion",
        "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus || suggestWidgetVisible && textInputFocus && !suggestWidgetHasFocusedSuggestion && !supermaven-view.visible"
    },
    {
        "key": "ctrl+n",
        "command": "selectNextCodeAction",
        "when": " codeActionMenuVisible"
    },
    {
        "key": "ctrl+p",
        "command": "selectPrevCodeAction",
        "when": "codeActionMenuVisible"
    },
    {
        "key": "ctrl+c",
        "command": "workbench.action.closeQuickOpen",
        "when": "inQuickOpen"
    },
    {
        "key": "shift+5",
        "command": "explorer.newFile",
        "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
    },
    {
        "key": "d",
        "command": "explorer.newFolder",
        "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
    },
    {
        "key": "shift-r",
        "command": "renameFile",
        "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
    },
    {
        "key": "x",
        "command": "filesExplorer.cut",
        "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
    },
    {
        "key": "y",
        "command": "filesExplorer.copy",
        "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceIsRoot && !inputFocus"
    },
    {
        "key": "p",
        "command": "filesExplorer.paste",
        "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceReadonly && !inputFocus"
    },
    {
        "key": "shift-d",
        "command": "deleteFile",
        "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceReadonly && !inputFocus"
    },
    {
        "key": "shift-t",
        "command": "moveFileToTrash",
        "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceReadonly && !inputFocus"
    },
    {
        "key": "z m",
        "command": "workbench.files.action.collapseExplorerFolders",
        "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceReadonly && !inputFocus"
    },
    {
        "key": "/",
        "command": "list.find",
        "when": "listFocus && listSupportsFind"
    },
    {
        "key": "tab",
        "command": "togglePeekWidgetFocus",
        "when": "referenceSearchVisible && inReferenceSearchEditor || referenceSearchVisible  && !inReferenceSearchEditor"
    },
    {
        "key": "escape",
        "command": "", // when in peek window editor, dont close
        "when": "inReferenceSearchEditor"
    },
    {
        "key": "alt+shift+h",
        "command": "workbench.action.decreaseViewWidth"
    },
    {
        "key": "alt+shift+l",
        "command": "workbench.action.increaseViewWidth"
    },
    {
        "key": "alt+shift+k",
        "command": "workbench.action.decreaseViewHeight"
    },
    {
        "key": "alt+shift+j",
        "command": "workbench.action.increaseViewHeight"
    },
    {
        "key": "ctrl+/",
        "command": "workbench.action.toggleMaximizeEditorGroup",
        "when": "editorPartMaximizedEditorGroup || editorPartMultipleEditorGroups"
    },
    {
        "key": "ctrl+/",
        "command": "workbench.action.toggleModalEditorMaximized",
        "when": "editorPartModal"
    },
    {
        "key": "ctrl+alt+m",
        "command": "workbench.action.movemain",
        "when": "editorPartModal"
    },
    {
        "key": "ctrl+m",
        "command": "workbench.action.moveModalEditorToMain",
        "when": "editorPartModal"
    },
    {
        "key": "ctrl+c",
        "command": "closeReferenceSearch", // when in peek window editor, close
        "when": "inReferenceSearchEditor"
    },
    {
        "key": "ctrl+shift+space",
        "command": "editor.action.triggerParameterHints",
        "when": "editorHasSignatureHelpProvider && editorTextFocus && !parameterHintsVisible"
    },
    {
        "key": "ctrl+shift+space",
        "command": "closeParameterHints",
        "when": "editorHasSignatureHelpProvider && editorTextFocus && parameterHintsVisible"
    },
    {
        "key": "ctrl+n",
        "command": "showNextParameterHint",
        "when": "editorFocus && parameterHintsMultipleSignatures && parameterHintsVisible"
    },
    {
        "key": "ctrl+p",
        "command": "showPrevParameterHint",
        "when": "editorFocus && parameterHintsMultipleSignatures && parameterHintsVisible"
    },
    {
        "key": "alt+s alt+h",
        "command": "workbench.action.moveActiveEditorGroupLeft",
        "when": "editorFocus"
    },
    {
        "key": "alt+s alt+l",
        "command": "workbench.action.moveActiveEditorGroupRight",
        "when": "editorFocus"
    },
    {
        "key": "alt+s alt+j",
        "command": "workbench.action.moveActiveEditorGroupDown",
        "when": "editorFocus"
    },
    {
        "key": "alt+s alt+k",
        "command": "workbench.action.moveActiveEditorGroupUp",
        "when": "editorFocus"
    },
    {
        "key": "alt+m alt+h",
        "command": "workbench.action.moveEditorToLeftGroup",
        "when": "editorFocus"
    },
    {
        "key": "alt+m alt+l",
        "command": "workbench.action.moveEditorToRightGroup",
        "when": "editorFocus"
    },
    {
        "key": "alt+m alt+j",
        "command": "workbench.action.moveEditorToBelowGroup",
        "when": "editorFocus"
    },
    {
        "key": "alt+m alt+k",
        "command": "workbench.action.moveEditorToAboveGroup",
        "when": "editorFocus"
    },
    {
        "key": "tab",
        "command": "search.action.focusQueryEditorWidget",
        "when": "inSearchEditor"
    },
    {
        "key": "shift+tab",
        "command": "search.action.focusNextSearchResult",
        "when": "inSearchEditor"
    },
    {
        "key": "ctrl+shift+q",
        "command": "workbench.view.explorer",
        "when": "viewContainer.workbench.view.explorer.enabled"
    },
    {
        "key": "ctrl+shift+g",
        "command": "workbench.view.scm",
        "when": "workbench.scm.active"
    },
    {
        "key": "ctrl+shift+u",
        "command": "cursorRedo",
        "when": "textInputFocus"
    },
    {
        "key": "ctrl+e",
        "command": "editorScroll",
        "args": {
            "to": "down",
            "by": "line",
            "value": 5
        },
        "when": "vim.mode == 'Normal' || vim.mode == 'Insert' || vim.mode == 'Visual' || vim.mode == 'VisualBlock' || vim.mode == 'VisualLine'"
    },
    {
        "key": "ctrl+y",
        "command": "editorScroll",
        "args": {
            "to": "up",
            "by": "line",
            "value": 5
        },
        "when": "vim.mode == 'Normal' || vim.mode == 'Insert' || vim.mode == 'Visual' || vim.mode == 'VisualBlock' || vim.mode == 'VisualLine'"
    },
    {
        "key": "ctrl+shift+e",
        "command": "editorScroll",
        "args": {
            "to": "down",
            "by": "line",
            "value": 1
        },
        "when": "vim.mode == 'Normal' || vim.mode == 'Insert' || vim.mode == 'Visual' || vim.mode == 'VisualBlock' || vim.mode == 'VisualLine'"
    },
    {
        "key": "ctrl+shift+y",
        "command": "editorScroll",
        "args": {
            "to": "up",
            "by": "line",
            "value": 1
        },
        "when": "vim.mode == 'Normal' || vim.mode == 'Insert' || vim.mode == 'Visual' || vim.mode == 'VisualBlock' || vim.mode == 'VisualLine'"
    },
    {
        "key": "ctrl+;",
        "command": "deleteAllRight",
        "when": "vim.mode == 'Insert'"
    },
    {
        "key": "alt+j",
        "command": "editor.action.moveLinesDownAction",
        "when": "vim.mode == 'Normal' || vim.mode == 'Insert' || vim.mode == 'VisualLine'"
    },
    {
        "key": "alt+k",
        "command": "editor.action.moveLinesUpAction",
        "when": "vim.mode == 'Normal' || vim.mode == 'Insert' || vim.mode == 'VisualLine'"
    },
    {
        "key": "ctrl+a",
        "command": "editor.action.addSelectionToNextFindMatch",
        "when": "editorFocus"
    },
    {
        "key": "ctrl+x",
        "command": "editor.action.addSelectionToPreviousFindMatch",
        "when": "editorFocus"
    },
    {
        "key": "ctrl+shift+a",
        "command": "editor.action.selectHighlights",
        "when": "editorFocus"
    },
]
// {
//     "key": "[ r",
