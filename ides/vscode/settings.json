{
    "[go]": {
        "editor.codeActionsOnSave": {
            "source.fixAll": "always",
            "source.organizeImports": "always"
        },
        // "editor.defaultFormatter": "golang.go",
        "editor.formatOnSave": true,
        "editor.indentSize": "tabSize",
        "editor.tabSize": 4
    },
    //
    "[json]": {
        "editor.formatOnSave": true,
        "editor.indentSize": "tabSize",
        "editor.tabSize": 4
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[snippets]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    //
    "accessibility.underlineLinks": true,
    "chat.disableAIFeatures": true,
    "chat.tips.enabled": false,
    "editor.bracketPairColorization.enabled": true,
    "editor.cursorBlinking": "solid",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.detectIndentation": false,
    "editor.fontFamily": "CommitMono Nerd Font Mono",
    "editor.fontLigatures": true,
    "editor.fontSize": 17,
    "editor.formatOnSave": true,
    "editor.gotoLocation.multipleDefinitions": "goto",
    "editor.guides.indentation": false,
    "editor.lineHeight": 1.5,
    "editor.lineNumbers": "relative",
    "editor.linkedEditing": true,
    "editor.matchBrackets": "never",
    "editor.minimap.enabled": false,
    "editor.multiCursorModifier": "ctrlCmd",
    "editor.occurrencesHighlight": "off",
    //
    "editor.quickSuggestions": {
        "comments": "on",
        "other": "on",
        "strings": "on"
    },
    "editor.renderLineHighlight": "none",
    "editor.renderWhitespace": "none",
    "editor.scrollbar.horizontal": "hidden",
    "editor.scrollbar.vertical": "hidden",
    "editor.selectionHighlight": false,
    "editor.semanticHighlighting.enabled": "configuredByTheme",
    "editor.showFoldingControls": "always",
    "editor.stablePeek": true,
    "editor.stickyScroll.enabled": false,
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.tabSize": 4,
    "editor.tokenColorCustomizations": {
        "[Islands Dark]": {}
    },
    "editor.wordWrap": "off",
    "explorer.autoReveal": false,
    "explorer.compactFolders": false,
    "explorer.confirmDelete": true,
    //
    "explorer.confirmDragAndDrop": true,
    "extensions.experimental.affinity": {
        "vscodevim.vim": 1
    },
    //
    // "tailwindCSS.experimental.classRegex": [
    //   "tw`(.*?)`",
    //   "tw\\('(.*?)'\\)",
    //   "tw\\(\\s*('(.*?)'|\"(.*?)\")\\s*\\)"
    // ], // mainly for tailwind
    //
    "extensions.ignoreRecommendations": true,
    "files.associations": {
        "*.vue": "vue"
    },
    "files.autoSave": "off",
    //
    "files.insertFinalNewline": true,
    //
    "git.decorations.enabled": false,
    "git.suggestSmartCommit": false,
    //
    "gitlab.duo.enabledWithoutGitlabProject": false,
    "gitlab.duoChat.enabled": false,
    "gitlab.duoCodeSuggestions.enabled": false,
    "go.alternateTools": {
        "customFormatter": "golangci-lint-v2"
    },
    "go.formatFlags": [
        "fmt",
        "--stdin"
    ],
    "go.formatTool": "custom",
    "go.lintFlags": [
        "--path-mode=abs",
        "--fast-only"
    ],
    "go.lintTool": "golangci-lint-v2",
    "gopls": {
        "ui.semanticTokens": true
    },
    "js/ts.experimental.useTsgo": true,
    "js/ts.suggest.autoImports": true,
    "js/ts.tsdk.path": "./node_modules/typescript",
    // "path-intellisense.showHiddenFiles": true, // you can also create custom paths by keymaps
    // "path-intellisense.absolutePathToWorkspace": true // if you need to start path from root "/"
    // "path-intellisense.autoSlashAfterDirectory": true,
    "path-intellisense.autoTriggerNextSuggestion": true,
    //
    "search.useIgnoreFiles": false,
    //
    "security.workspace.trust.untrustedFiles": "open",
    //
    "settingsSync.keybindingsPerPlatform": false,
    //
    "telemetry.telemetryLevel": "off",
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "terminal.integrated.fontFamily": "CommitMono Nerd Font Mono",
    "terminal.integrated.fontLigatures.enabled": true,
    //
    "terminal.integrated.fontSize": 16,
    "vim.enableNeovim": true,
    "vim.handleKeys": {
        "<C-;>": true,
        // false - delegate to vscode
        // true - disable for vscode
        "<C-d>": true,
        "<C-s>": true,
        "<C-z>": true
    },
    "vim.highlightedyank.color": "#25303d",
    "vim.highlightedyank.duration": 200,
    "vim.highlightedyank.enable": true,
    "vim.hlsearch": true,
    "vim.insertModeKeyBindings": [
        {
            "after": [
                "<Esc>"
            ],
            "before": [
                "j",
                "k"
            ]
        },
        {
            "before": [
                "<C-i>"
            ],
            "commands": [
                "cursorHome"
            ]
        },
        {
            "before": [
                "<C-a>"
            ],
            "commands": [
                "cursorEnd"
            ]
        },
        {
            "before": [
                "<C-k>"
            ],
            "commands": [
                "deleteWordRight"
            ]
        },
        {
            "before": [
                "<C-l>"
            ],
            "commands": [
                "deleteRight"
            ]
        },
        {
            "before": [
                "<C-u>"
            ],
            "commands": [
                "deleteAllLeft"
            ]
        },
    ],
    "vim.leader": "space",
    "vim.normalModeKeyBindings": [
        // {
        //     "before": [
        //         "q"
        //     ],
        //     "commands": []
        // },
        {
            "before": [
                "q"
            ],
            "commands": [
                ":nohl"
            ],
            "silent": true
        },
        {
            "before": [
                "+"
            ],
            "commands": [
                "extension.vim_ctrl+a"
            ],
            "silent": true
        },
        {
            "before": [
                "-"
            ],
            "commands": [
                "extension.vim_ctrl+x"
            ],
            "silent": true
        },
        {
            "before": [
                "<C-space>"
            ],
            "commands": [
                "extension.vim_ctrl+6"
            ],
            "silent": true
        },
        {
            "before": [
                ">"
            ],
            "commands": [
                "editor.action.indentLines"
            ]
        },
        {
            "before": [
                "<"
            ],
            "commands": [
                "editor.action.outdentLines"
            ]
        },
        {
            "before": [
                "<leader>",
                "p",
                "h"
            ],
            "commands": [
                "editor.action.dirtydiff.next"
            ]
        },
        {
            "before": [
                "<leader>",
                "w",
                "w"
            ],
            "commands": [
                "editor.action.toggleWordWrap"
            ]
        },
        // {
        //     "before": [
        //         "<C-h>"
        //     ],
        //     "commands": [
        //         "editor.gotoParentFold"
        //     ]
        // },
        {
            "before": [
                "<C-h>"
            ],
            "commands": [
                "editor.gotoParentFold"
            ]
        },
        // {
        //     "before": [
        //         "<leader>",
        //         "<leader>"
        //     ],
        //     "commands": [
        //         "workbench.action.quickTextSearch"
        //     ]
        // },
        {
            "before": [
                "<leader>",
                "/"
            ],
            "commands": [
                "search.action.openEditor"
            ]
        },
        {
            "before": [
                "g",
                "s",
            ],
            "commands": [
                "workbench.action.gotoSymbol"
            ]
        },
        {
            "before": [
                "g",
                "<S-s>",
            ],
            "commands": [
                "workbench.action.showAllSymbols"
            ]
        },
        {
            "before": [
                "g",
                "<S-d>",
            ],
            "commands": [
                "editor.action.goToDeclaration"
            ]
        },
        {
            "before": [
                "g",
                "y",
            ],
            "commands": [
                "editor.action.goToTypeDefinition"
            ]
        },
        {
            "before": [
                "g",
                "r",
                "r"
            ],
            "commands": [
                "editor.action.goToReferences"
            ]
        },
        {
            "before": [
                "g",
                "r",
                "n"
            ],
            "commands": [
                "editor.action.rename"
            ]
        },
        {
            "before": [
                "g",
                "r",
                "i"
            ],
            "commands": [
                "editor.action.goToImplementation"
            ]
        },
        {
            "before": [
                "g",
                "r",
                "a"
            ],
            "commands": [
                "editor.action.codeAction"
            ]
        },
        {
            "before": [
                "<S-k>"
            ],
            "commands": [
                "editor.action.showDefinitionPreviewHover",
            ]
        },
        {
            "before": [
                "[",
                "d"
            ],
            "commands": [
                "editor.action.marker.prev",
            ]
        },
        {
            "before": [
                "]",
                "d"
            ],
            "commands": [
                "editor.action.marker.next",
            ]
        },
        {
            "before": [
                "[",
                "D"
            ],
            "commands": [
                "editor.action.marker.prevInFiles",
            ]
        },
        {
            "before": [
                "]",
                "D"
            ],
            "commands": [
                "editor.action.marker.nextInFiles",
            ]
        },
        {
            "before": [
                "[",
                "c"
            ],
            "commands": [
                "editor.action.dirtydiff.previous",
            ]
        },
        {
            "before": [
                "]",
                "c"
            ],
            "commands": [
                "editor.action.dirtydiff.next",
            ]
        },
        {
            "before": [
                "[",
                "k"
            ],
            "commands": [
                "workbench.action.compareEditor.previousChange",
            ]
        },
        {
            "before": [
                "]",
                "k"
            ],
            "commands": [
                "workbench.action.compareEditor.nextChange",
            ]
        },
        {
            "before": [
                "]",
                "k"
            ],
            "commands": [
                "workbench.action.compareEditor.nextChange",
            ]
        },
        {
            "after": [
                "<S-A-right>"
            ],
            "before": [
                " ",
                "x"
            ]
        },
    ],
    "vim.useCtrlKeys": true,
    //
    "vim.useSystemClipboard": true,
    "vim.visualModeKeyBindings": [
        {
            "before": [
                "q"
            ],
            "commands": []
        },
        {
            "before": [
                ">"
            ],
            "commands": [
                "editor.action.indentLines"
            ]
        },
        {
            "before": [
                "<"
            ],
            "commands": [
                "editor.action.outdentLines"
            ]
        },
        {
            "before": [
                "g",
                "<S-a>"
            ],
            "commands": [
                "editor.action.insertCursorAtEndOfEachLineSelected"
            ]
        }
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
        {
            "after": [
                "p",
                "g",
                "v",
                "y"
            ],
            "before": [
                "p"
            ]
        }
    ],
    "vim.visualstar": true,
    "window.customMenuBarAltFocus": false,
    "window.customTitleBarVisibility": "never",
    "window.enableMenuBarMnemonics": false,
    //
    "window.menuBarVisibility": "hidden",
    "window.titleBarStyle": "native",
    "window.zoomLevel": 1,
    "workbench.colorCustomizations": {
        "[Islands Dark]": {
            "editorCursor.background": "#FAF8F9",
            "editorCursor.foreground": "#2F81F7",
            "editorGroup.border": "#00ACC1",
            "focusBorder": "#00ACC1"
        }
    },
    "workbench.colorTheme": "Islands Dark",
    "workbench.editor.centeredLayoutAutoResize": true,
    "workbench.editor.editorActionsLocation": "hidden",
    "workbench.editor.enablePreview": false,
    "workbench.editor.showTabs": "none",
    "workbench.editor.useModal": "some",
    //
    "workbench.iconTheme": "material-icon-theme",
    "workbench.sideBar.location": "right",
    "workbench.startupEditor": "none",
    "workbench.tips.enabled": false,
    "workbench.tree.enableStickyScroll": false,
    "workbench.tree.renderIndentGuides": "none",
    "zenMode.hideStatusBar": false,
    //
    "zenMode.showTabs": "none"
}
