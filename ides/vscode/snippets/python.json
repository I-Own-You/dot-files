{
	// Place your snippets for python here. Each snippet is defined under a snippet name and has a prefix, body and 
	// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the 
	// same ids are connected.
	// Example:
	// "Print to console": {
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }
	"sample-for": {
		"prefix": "for",
		"body": [
			"for ${1:el} in ${2:seq}:",
			"\t$0"
		],
	},
	"for-range": {
		"prefix": "fr",
		"body": [
			"for ${1:el} in range($2):",
			"\t$0"
		],
	},
	"for-enumerate": {
		"prefix": "fe",
		"body": [
			"for ${1:ind}, ${2:el} in enumerate($3):",
			"\t$0"
		],
	},
	"for-reversed": {
		"prefix": "fre",
		"body": [
			"for ${1:el} in reversed($2):",
			"\t$0"
		],
	},
	"for-zip": {
		"prefix": "fz",
		"body": [
			"for ${1:el} in zip($2, $3):",
			"\t$0"
		],
	},
	"list-generator": {
		"prefix": "lg",
		"body": "[${0:el} for ${1:el} in ${2:seq}]"
	},
	"tuple-generator": {
		"prefix": "tg",
		"body": "(${0:el} for ${1:el} in ${2:seq})"
	},
	"dict-generator": {
		"prefix": "dg",
		"body": "{${4:el1}:${0:el2} for ${1:el1},${2:el2} in ${3:seq}}"
	},
	"def": {
		"prefix": "def",
		"body": [
			"def ${1:func_name}($2):",
			"\t$0"
		]
	},
	"if": {
		"prefix": "if",
		"body": [
			"if ${1:expression}:",
			"\t$0"
		]
	},
	"class": {
		"prefix": "class",
		"body": [
			"class ${1:class_name}:",
			"\tdef __init__(self$2):",
			"\t\t$0"
		]
	},
	"while": {
		"prefix": "while",
		"body": [
			"while ${1:expression}:",
			"\t$0"
		]
	},
	"try-except": {
		"prefix": "te",
		"body": [
			"try:",
			"\t$1",
			"except ${2:Exception} as e:",
			"\t${0:pass}"
		]
	},
	"with": {
		"prefix": "with",
		"body": [
			"with open('$1', '${2|r,w,a,b,+|}') as ${3:f}:",
			"\t"
		]
	},
	"open": {
		"prefix": "open",
		"body": "${1:f} = open('$2', '${3|r,w,a,b,+|}')$0"
	},
	"from": {
		"prefix": "from",
		"body": "from ${1:module} import ${0:what_to_import}"
	}
}