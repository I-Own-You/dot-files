[
    // non vim keybindings
    // terminal
    {
        "bindings": {
            "ctrl-n": "menu::SelectNext",
            "ctrl-p": "menu::SelectPrevious",
        },
    },
    {
        "context": "Workspace",
        "bindings": {
            "alt-t": "terminal_panel::ToggleFocus",
        },
    },
    {
        "context": "Terminal",
        "bindings": { "alt-t": "terminal_panel::ToggleFocus" },
    },

    // vim keybindings
    {
        "context": "VimControl && !menu",
        "bindings": {
            // "n": ["workspace::SendKeystrokes", "n z z"],
            // "N": ["workspace::SendKeystrokes", "N z z"],
            "ctrl-space": "pane::AlternateFile",
        },
    },
    {
        "context": "vim_mode == normal",
        "bindings": {
            "+": "vim::Increment",
            "-": "vim::Decrement",
        },
    },
    {
        "context": "vim_mode == visual",
        "bindings": {
            ">": "editor::Indent",
            "<": "editor::Outdent",
        },
    },
    {
        // only while an editor has focus and you’re in Normal or Visual mode
        "context": "Editor && (vim_mode == normal || vim_mode == visual)",
        "bindings": {
            "space p h": "editor::ToggleSelectedDiffHunks", // show / hide inline diff of the hunk under the cursor
            "space s h": "git::ToggleStaged",
            "space u s h": "git::UnstageAndNext",
            "space r b b": "git::RestoreFile",
            "space s b": "git::StageAll",
            "space r b i": "git::UnstageAll",
            "space r h": "git::Restore",
            "space g b b": "git::Switch",
            "space g i d": "git::Diff",
        },
    },
    {
        "context": "Editor && vim_mode == visual && !VimWaiting && !VimObject",
        "bindings": {
            "p": ["vim::Paste", { "preserveClipboard": true }],
        },
    },
    {
        "context": "GitPanel",
        "bindings": {
            "q": "git_panel::Close",
        },
    },
    {
        "context": "Editor && vim_mode == normal",
        "bindings": {
            "space e": "project_panel::ToggleFocus",
            "space g c": "git::Commit",
            "space g p": "git::Push",
            "space b l": "git::Blame",
            "space m t": "git_panel::ToggleFocus",
            "space g b b": "git::Branch",
            "space l w": "diagnostics::Deploy",

            // "alt-shift-h": "vim::ResizePaneLeft",
            // "alt-shift-l": "vim::ResizePaneRight",
            // "alt-shift-j": "vim::ResizePaneDown",
            // "alt-shift-k": "vim::ResizePaneUp",
            "alt-shift-h": [
                "workspace::SendKeystrokes",
                "ctrl-w < ctrl-w < ctrl-w <",
            ],
            "alt-shift-l": [
                "workspace::SendKeystrokes",
                "ctrl-w > ctrl-w > ctrl-w >",
            ],
            "alt-shift-j": [
                "workspace::SendKeystrokes",
                "ctrl-w - ctrl-w - ctrl-w -",
            ],
            "alt-shift-k": [
                "workspace::SendKeystrokes",
                "ctrl-w + ctrl-w + ctrl-w +",
            ],

            "ctrl-/": "workspace::ToggleZoom",
        },
    },
    {
        "context": "Editor && vim_mode == insert",
        "bindings": {
            "j k": ["workspace::SendKeystrokes", "escape"],
            "ctrl-e": "editor::LineDown",
            "ctrl-y": "editor::LineUp",
            "ctrl-i": ["workspace::SendKeystrokes", "ctrl-o shift-i"],
            "ctrl-a": ["workspace::SendKeystrokes", "ctrl-o shift-a"],
            "ctrl-k": "editor::DeleteToNextWordEnd",
            "ctrl-;": "editor::DeleteToEndOfLine",
            "ctrl-l": "vim::DeleteRight",
            "ctrl-h": "vim::DeleteLeft",
            "ctrl-j": null,
            // "ctrl-k": null,
            "ctrl-v": null,
            "ctrl-q": null,
            "ctrl-shift-q": null,
        },
    },
    {
        "context": "Editor && vim_mode == insert && showing_completions || (Editor && showing_code_actions)",
        "bindings": {
            "ctrl-e": "editor::Cancel",
            "ctrl-c": "editor::Cancel",
        },
    },
    {
        "context": "Editor && (vim_mode == normal || vim_mode == insert || vim_mode == visual)",
        "bindings": {
            "alt-j": "editor::MoveLineDown",
            "alt-k": "editor::MoveLineUp",
        },
    },
    {
        "context": "VimControl && !menu",
        "bindings": {
            "q": null,
            "ctrl-e": [
                "workspace::SendKeystrokes",
                "ctrl-e ctrl-e ctrl-e ctrl-e ctrl-e",
            ],
            "ctrl-y": [
                "workspace::SendKeystrokes",
                "ctrl-y ctrl-y ctrl-y ctrl-y ctrl-y",
            ],
        },
    },
    {
        "context": "Editor && mode == full && vim_mode == normal",
        "bindings": {
            "space w w": "editor::ToggleSoftWrap",
            "space n h": "buffer_search::Dismiss",
            "space b o": "pane::CloseOtherItems",
        },
    },
    {
        "context": "Workspace",
        "bindings": {
            "alt-a": "file_finder::Toggle",
            "alt-f": "tab_switcher::ToggleAll",
        },
    },
    {
        "context": "FileFinder",
        "bindings": {
            "alt-a": "menu::Cancel",
        },
    },
    {
        "context": "TabSwitcher",
        "bindings": {
            "alt-f": "menu::Cancel",
            "ctrl-x ctrl-x": "tab_switcher::CloseSelectedItem",
        },
    },
    {
        "context": "ProjectPanel && not_editing",
        "bindings": {
            "q": "project_panel::Toggle",
            "space e": "project_panel::ToggleFocus",
            "x": "project_panel::Cut",
            "y": "project_panel::Copy",
            "p": "project_panel::Paste",
            "shift-t": ["project_panel::Trash", { "skip_prompt": false }],
            "z m": "project_panel::CollapseAllEntries",
            "z r": "project_panel::ExpandAllEntries",
        },
    },
    {
        "context": "FileFinder || (FileFinder > Picker > Editor) || (FileFinder > Picker > menu)",
        "bindings": {
            "ctrl-j": "pane::SplitDown",
            "ctrl-k": "pane::SplitUp",
            "ctrl-h": "pane::SplitLeft",
            "ctrl-l": "pane::SplitRight",
        },
    },
    {
        "context": "vim_mode == normal || vim_mode == visual || vim_mode == operator",
        "bindings": {
            "ctrl-h": "vim::PreviousLesserIndent",
            "ctrl-k": "vim::PreviousSameIndent",
            "ctrl-l": "vim::NextGreaterIndent",
            "ctrl-j": "vim::NextSameIndent",
        },
    },
    {
        "context": "Editor && mode == full && vim_mode == normal",
        "bindings": {
            "space space": "text_finder::Toggle",
        },
    },
    {
        "context": "VimControl && !menu || !Editor && !Terminal",
        "bindings": {
            "ctrl-w ctrl-h": [
                "workspace::MoveItemToPaneInDirection",
                { "direction": "left" },
            ],
            "ctrl-w ctrl-l": [
                "workspace::MoveItemToPaneInDirection",
                { "direction": "right" },
            ],
            "ctrl-w ctrl-j": [
                "workspace::MoveItemToPaneInDirection",
                { "direction": "down" },
            ],
            "ctrl-w ctrl-k": [
                "workspace::MoveItemToPaneInDirection",
                { "direction": "up" },
            ],
        },
    },
]

