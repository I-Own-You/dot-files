{
    "icon_theme": "Clean VSCode Icon Theme",
    "disable_ai": true,
    "ui_font_size": 17,
    "ui_font_weight": 300,
    "ui_font_family": "CommitMono Nerd Font Mono",
    "buffer_font_size": 20,
    "buffer_font_weight": 300,
    "buffer_font_family": "CommitMono Nerd Font Mono",
    "buffer_line_height": {
        "custom": 1.4,
    },
    "theme": {
        "mode": "dark",
        "light": "One Light",
        "dark": "Min Dark (Solid)",
    },
    "theme_overrides": {
        "Min Dark (Solid)": {
            "border.selected": "#0090ff",
        },
    },
    "current_line_highlight": "all",
    "cursor_blink": false,
    "file_finder": {
        "modal_max_width": "large",
    },
    "relative_line_numbers": "enabled",
    "preferred_line_length": 80,
    "show_whitespaces": "selection",
    "soft_wrap": "none",
    "tab_size": 4,
    "unnecessary_code_fade": 0.3,
    "active_pane_modifiers": {
        "border_size": 2,
        // "inactive_opacity": 0.5,
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
    "auto_install_extensions": {
        "html": true,
        "clean-vscode-icons": true,
        "golangci-lint": true,
        "tsgo": true,
        "min-theme": true,
        "biome": true,
    },
    // save
    "autosave": "off",
    "ensure_final_newline_on_save": true,
    "remove_trailing_whitespace_on_save": true,
    "format_on_save": "on",
    "formatter": "auto",
    "auto_update": true,
    // lsp settings
    "enable_language_server": true,
    "lsp_highlight_debounce": 999999999999, // workaround to disable highlight of every same word
    // lsp setup
    "lsp": {
        // this is for tailwind to work inside .ts files
        // "tailwindcss-language-server": {
        // "settings": {
        //     "experimental": {
        //         "classRegex": [
        //             "\\.className\\s*[+]?=\\s*['\"]([^'\"]*)['\"]",
        //             "\\.setAttributeNS\\(.*,\\s*['\"]class['\"],\\s*['\"]([^'\"]*)['\"]",
        //             "\\.setAttribute\\(['\"]class['\"],\\s*['\"]([^'\"]*)['\"]",
        //             "\\.classList\\.add\\(['\"]([^'\"]*)['\"]",
        //             "\\.classList\\.remove\\(['\"]([^'\"]*)['\"]",
        //             "\\.classList\\.toggle\\(['\"]([^'\"]*)['\"]",
        //             "\\.classList\\.contains\\(['\"]([^'\"]*)['\"]",
        //             "\\.classList\\.replace\\(\\s*['\"]([^'\"]*)['\"]",
        //             "\\.classList\\.replace\\([^,)]+,\\s*['\"]([^'\"]*)['\"]",
        //         ],
        //     },
        // },
        // },
        //
        // this is for typescript inlay hints
        // "typescript-ls": {
        //     "initialization_options": {
        //         "preferences": {
        //             "includeInlayParameterNameHints": "all",
        //             "includeInlayParameterNameHintsWhenArgumentMatchesName": true,
        //             "includeInlayFunctionParameterTypeHints": true,
        //             "includeInlayVariableTypeHints": true,
        //             "includeInlayVariableTypeHintsWhenTypeMatchesName": true,
        //             "includeInlayPropertyDeclarationTypeHints": true,
        //             "includeInlayFunctionLikeReturnTypeHints": true,
        //             "includeInlayEnumMemberValueHints": true,
        //         },
        //     },
        // },
        "biome": {
            "settings": {
                // will start biome only if biome.json/c file is available in the folder
                "require_config_file": true,
                // go to lsp for: variables, css classes in jsx/tsx/html, jstx/tsx/html components
                // "goto_definition": false,
            },
        },
    },
    "languages": {
        // ! in front of an lsp means dont run it
        // "..." as an option means keep loading any other lsp which is by default assigned to
        // to this lsp language
        "TypeScript": {
            "language_servers": [
                "typescript-ls",
                "!vtsls",
                "!typescript-language-server",
                "!eslint",
                "...",
            ],
            "prettier": {
                "allowed": false,
            },
            "format_on_save": "on",
            "formatter": {
                "language_server": {
                    "name": "biome",
                },
            },
            // will run code actions after the biome format
            // "code_actions_on_format": {
            //     "source.organizeImports.biome": true,
            //     // 1. this is for assist options inside biome.jsonc, if enable here, enable there
            //     "source.fixAll.biome": true,
            //     // 2. the above doesnt enable the below, they go on par, but you must add actions by yourself,
            //     //    there are currently 10 source actionss, this is one of it:
            //     "source.action.useSortedKeys.biome": true,
            // },
        },
        "JavaScript": {
            "language_servers": [
                "typescript-ls",
                "!vtsls",
                "!typescript-language-server",
                "!eslint",
                "...",
            ],
            "prettier": {
                "allowed": false,
            },
            "formatter": {
                "language_server": {
                    "name": "biome",
                },
            },
        },
        "TSX": {
            "language_servers": [
                "typescript-ls",
                "!vtsls",
                "!typescript-language-server",
                "!eslint",
                "...",
            ],
            "prettier": {
                "allowed": false,
            },
            "formatter": {
                "language_server": {
                    "name": "biome",
                },
            },
        },
        "CSS": {
            "language_servers": [
                // tailwind specific rules will work inside .css files
                "tailwindcss-intellisense-css",
                "!vscode-css-language-server",
                "...",
            ],
            "formatter": {
                "language_server": {
                    "name": "biome",
                },
            },
        },
    },
    // code lenses can be changed inside lsp for specific lsp and within its settings
    "code_lens": "on",
    "linked_edits": true,
    "scrollbar": {
        "show": "never",
    },
    "tab_bar": {
        "show": false,
        "show_nav_history_buttons": false,
        "show_tab_bar_buttons": false,
    },
    "extend_comment_on_newline": false,
    "file_scan_exclusions": [
        // default settings are needed because if i specify without the default settings,
        // it will overwrite them.
        "**/.git",
        "**/.svn",
        "**/.hg",
        "**/.jj",
        "**/CVS",
        "**/.DS_Store",
        "**/Thumbs.db",
        "**/.classpath",
        "**/.settings",
        // my files
        "**/.node_modules",
    ],
    "file_scan_inclusions": [".env*"],
    // "file_types": {
    //   "Dockerfile": ["Dockerfile*"]
    // },
    "git": {
        "inline_blame": {
            "enabled": false,
            "show_commit_summary": true,
        },
    },
    "diff_view_style": "split",
    "indent_guides": {
        "enabled": false,
        "coloring": "indent_aware",
    },
    "base_keymap": "VSCode",
    "vim_mode": true,
    "vim": {
        "use_system_clipboard": "always",
    },
    "hover_popover_enabled": false,
    "project_panel": {
        "hide_root": true,
        "indent_guides": {
            "show": "never",
        },
        "scrollbar": {
            "show": "never",
        },
    },
    "agent": {
        "enabled": false,
        "button": false,
    },
    "outline_panel": {
        "default_width": 280,
        "git_status": false,
        "indent_guides": {
            "show": "never",
        },
        "scrollbar": {
            "show": "never",
        },
    },
    "calls": {
        "mute_on_join": true,
    },
    "collaboration_panel": {
        "button": false,
    },
    "diagnostics": {
        "inline": {
            "enabled": true,
        },
    },
    "search": {
        "include_ignored": true,
        "regex": true,
    },
    "use_smartcase_search": true,
    "tasks": {
        "enabled": true,
        "variables": {},
    },
    // "profiles": {
    //     "presentation": {
    //         "buffer_font_size": 20,
    //         "ui_font_size": 18,
    //         "theme": "One Light"
    //     }
    // }
}
