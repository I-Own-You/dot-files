{
    "package main and main function": {
        "prefix": "pkgm",
        "body": "package main\n\nfunc main() {\n\t$0\n}",
        "description": "Snippet for main package & function"
    },
    "for statement": {
        "prefix": "fori",
        "body": "for ${1:i} := ${2:0}; $1 < ${3:count}; $1${4:++} {\n\t$0\n}",
        "description": "Snippet for a for loop"
    },
    "for range statement": {
        "prefix": "forr",
        "body": "for ${1:_}, ${2:v} := range ${3:v} {\n\t$0\n}",
        "description": "Snippet for a for range loop"
    },
    "for range single var statement": {
        "prefix": "forv",
        "body": "for ${1:v} := range ${2:v} {\n\t$0\n}",
        "description": "Snippet for a for range loop with single variable (e.g. channel)"
    },
    "if err != nil": {
        "prefix": "iferr",
        "body": "if err != nil {\n\t${1:return ${2:nil, }${3:err}}\n}",
        "description": "Snippet for if err != nil"
    },
    "if err wrap": {
        "prefix": "iferrw",
        "body": "if err != nil {\n\treturn fmt.Errorf(\"${1:context}: %w\", err)\n}",
        "description": "if err != nil with wrapped error"
    },
    "fmt.Println": {
        "prefix": "fp",
        "body": "fmt.Println($1)",
        "description": "Snippet for fmt.Println()"
    },
    "fmt.Printf": {
        "prefix": "ff",
        "body": "fmt.Printf(\"$1\", ${2:var})",
        "description": "Snippet for fmt.Printf()"
    },
    "log.Println": {
        "prefix": "lp",
        "body": "log.Println($1)",
        "description": "Snippet for log.Println()"
    },
    "log.Printf": {
        "prefix": "lf",
        "body": "log.Printf(\"$1\", ${2:var})",
        "description": "Snippet for log.Printf()"
    },
    "log variable content": {
        "prefix": "lv",
        "body": "log.Printf(\"${1:var}: %#+v\\\\n\", ${1:var})",
        "description": "Snippet for log.Printf() with variable content"
    },
    "if err log return": {
        "prefix": "iferrl",
        "body": "if err != nil {\n\tlog.Printf(\"${1:context}: %v\", err)\n\treturn $2\n}",
        "description": "Log error and return"
    },
    "http ResponseWriter *Request": {
        "prefix": "wr",
        "body": "${1:w} http.ResponseWriter, ${2:r} *http.Request",
        "description": "Snippet for http Response"
    },
    "http.HandleFunc": {
        "prefix": "hf",
        "body": "${1:http}.HandleFunc(\"${2:/}\", ${3:handler})",
        "description": "Snippet for http.HandleFunc()"
    },
    "http handler declaration": {
        "prefix": "hand",
        "body": "func $1(${2:w} http.ResponseWriter, ${3:r} *http.Request) {\n\t$0\n}",
        "description": "Snippet for http handler declaration"
    },
    "http.Redirect": {
        "prefix": "rd",
        "body": "http.Redirect(${1:w}, ${2:r}, \"${3:/}\", ${4:http.StatusFound})",
        "description": "Snippet for http.Redirect()"
    },
    "http.Error": {
        "prefix": "herr",
        "body": "http.Error(${1:w}, ${2:err}.Error(), ${3:http.StatusInternalServerError})",
        "description": "Snippet for http.Error()"
    },
    "http.ListenAndServe": {
        "prefix": "lsv",
        "body": "http.ListenAndServe(\"${1::8080}\", ${2:nil})",
        "description": "Snippet for http.ListenAndServe"
    },
    "http.Serve": {
        "prefix": "sv",
        "body": "http.Serve(\"${1::8080}\", ${2:nil})",
        "description": "Snippet for http.Serve"
    },
    "goroutine anonymous function": {
        "prefix": "go",
        "body": "go func($1) {\n\t$0\n}($2)",
        "description": "Snippet for anonymous goroutine declaration"
    },
    "goroutine function": {
        "prefix": "gf",
        "body": "go ${1:func}($0)",
        "description": "Snippet for goroutine declaration"
    },
    "defer statement": {
        "prefix": "df",
        "body": "defer ${1:func}($0)",
        "description": "Snippet for defer statement"
    },
    "test function": {
        "prefix": "tf",
        "body": "func Test$1(t *testing.T) {\n\t$0\n}",
        "description": "Snippet for Test function"
    },
    "test main": {
        "prefix": "tm",
        "body": "func TestMain(m *testing.M) {\n\t$1\n\n\tos.Exit(m.Run())\n}",
        "description": "Snippet for TestMain function"
    },
    "benchmark function": {
        "prefix": "bf",
        "body": "func Benchmark$1(b *testing.B) {\n\tfor b.Loop() {\n\t\t$0\n\t}\n}",
        "description": "Snippet for Benchmark function"
    },
    "table driven test": {
        "prefix": "tdt",
        "body": "func Test$1(t *testing.T) {\n\ttestCases := []struct {\n\t\tdesc\tstring\n\t\t$2\n\t}{\n\t\t{\n\t\t\tdesc: \"$3\",\n\t\t\t$4\n\t\t},\n\t}\n\tfor _, tC := range testCases {\n\t\tt.Run(tC.desc, func(t *testing.T) {\n\t\t\t$0\n\t\t})\n\t}\n}",
        "description": "Snippet for table driven test"
    },
    "init function": {
        "prefix": "finit",
        "body": "func init() {\n\t$1\n}",
        "description": "Snippet for init function"
    },
    "main function": {
        "prefix": "fmain",
        "body": "func main() {\n\t$1\n}",
        "description": "Snippet for main function"
    },
    "method declaration": {
        "prefix": "meth",
        "body": "func (${1:receiver} ${2:type}) ${3:method}($4) $5 {\n\t$0\n}",
        "description": "Snippet for method declaration"
    },
    "hello world web app": {
        "prefix": "helloweb",
        "body": "package main\n\nimport (\n\t\"fmt\"\n\t\"net/http\"\n\t\"time\"\n)\n\nfunc greet(w http.ResponseWriter, r *http.Request) {\n\tfmt.Fprintf(w, \"Hello World! %s\", time.Now())\n}\n\nfunc main() {\n\thttp.HandleFunc(\"/\", greet)\n\thttp.ListenAndServe(\":8080\", nil)\n}",
        "description": "Snippet for sample hello world webapp"
    },
    "sort implementation": {
        "prefix": "sort",
        "body": "type ${1:SortBy} []${2:Type}\n\nfunc (a $1) Len() int           { return len(a) }\nfunc (a $1) Swap(i, j int)      { a[i], a[j] = a[j], a[i] }\nfunc (a $1) Less(i, j int) bool { ${3:return a[i] < a[j]} }",
        "description": "Snippet for a custom sort.Sort interface implementation, for a given slice type."
    },
    "context": {
        "prefix": "ctx",
        "body": "ctx, cancel := context.WithCancel(${1:ctx})\ndefer cancel()\n$0",
        "description": "Context with cancel"
    },
    "context timeout": {
        "prefix": "ctx2",
        "body": "ctx, cancel := context.WithTimeout(${1:ctx}, ${2:time.Second})\ndefer cancel()\n$0",
        "description": "Context with timeout"
    },
    "channel": {
        "prefix": "ch",
        "body": "${1:ch} := make(chan ${2:type})",
        "description": "Create channel"
    },
    "channel buffered": {
        "prefix": "chb",
        "body": "${1:ch} := make(chan ${2:type}, ${3:size})",
        "description": "Create buffered channel"
    },
    "chanel receiver/consumer": {
        "prefix": "chr",
        "body": "${1:ch} <- ${2:value}",
        "description": "Create buffered channel"
    },
    "chanel producer": {
        "prefix": "chp",
        "body": "<- ${1:ch}",
        "description": "Create buffered channel"
    },
    "chanel close": {
        "prefix": "chc",
        "body": "close(${1:ch})",
        "description": "Create buffered channel"
    },
    "struct empty value": {
        "prefix": "ss",
        "body": "struct{}{}",
        "description": "Create buffered channel"
    },
    "json decode": {
        "prefix": "jd",
        "body": "if err := json.NewDecoder(${1:r.Body}).Decode(&${2:v}); err != nil {\n\treturn $3\n}",
        "description": "Decode JSON"
    },
    "json encode": {
        "prefix": "je",
        "body": "if err := json.NewEncoder(${1:w}).Encode(${2:v}); err != nil {\n\treturn $3\n}",
        "description": "Encode JSON"
    },
    "test assert error": {
        "prefix": "terr",
        "body": "if err == nil {\n\tt.Fatal(\"expected error\")\n}",
        "description": "Test expected error"
    },
    "test require no error": {
        "prefix": "tnoerr",
        "body": "if err != nil {\n\tt.Fatalf(\"unexpected error: %v\", err)\n}",
        "description": "Test unexpected error"
    },
    "test fatalf": {
        "prefix": "tfatal",
        "body": "t.Fatalf(\"${1:message}: %v\", ${2:value})",
        "description": "Test fatalf"
    },
    "interface implementation check": {
        "prefix": "impl",
        "body": "var _ ${1:Interface} = (*${2:Type})(nil)",
        "description": "Compile-time interface implementation check"
    },
    "errors.Is": {
        "prefix": "eis",
        "body": "errors.Is(${1:err}, ${2:target})",
        "description": "Check wrapped error"
    },
    "errors.As": {
        "prefix": "eas",
        "body": "var ${1:target} ${2:Type}\nif errors.As(${3:err}, &${1:target}) {\n\t$0\n}",
        "description": "Extract typed error"
    }
}
